#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]:-$0}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"
export DOTFILES="$dotfilesDirectory"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
	# Set macOS defaults
	"$DOTFILES/macos/set-defaults.sh"

	# Install homebrew
	"$DOTFILES/homebrew/install.sh" 2>&1

	# Upgrade homebrew
	echo "› brew update"
	brew update
elif [ "$OS" = "Linux" ]; then
	# Install apt packages, fonts, etc.
	"$DOTFILES/linux/install.sh"
fi

# Install software (runs Brewfile on macOS, all topic install.sh files everywhere)
echo "› $DOTFILES/script/install"
"$DOTFILES/script/install"
