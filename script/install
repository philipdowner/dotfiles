#!/bin/sh

# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..

# macOS: install Brewfile contents.
if [ "$(uname -s)" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
  brew bundle --force || true
fi

# Linux: install apt packages from linux/Aptfile (handled by linux/install.sh
# below via the find loop). Nothing extra to do here.

# find the installers and run them iteratively.
find . -name install.sh | while read -r installer ; do
  sh -c "$installer"
done
